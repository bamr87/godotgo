# Godot 4+
.godot/
/android/

# Exports
build/
export.cfg
export_credentials.cfg
*.translation

# OS
.DS_Store
Thumbs.db

# Python tooling (gdtoolkit)
.venv/

# Editors
*.swp
*.swo
.idea/
*.iml

# Local Material Maker scratch (keep committed exports)
*.mm.tmp

# Claude Code per-machine settings (Godot path, personal permissions)
.claude/settings.local.json

